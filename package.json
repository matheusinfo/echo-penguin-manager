{
  "name": "echo-data-viewer",
  "productName": "Echo Manager",
  "version": "0.1.0",
  "description": "Desktop manager for an Echo Show 5 running echo-penguin (Alpine Linux)",
  "author": {
    "name": "Matheus Andrade",
    "email": "matheus.add12@gmail.com"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "install-desktop": "bash scripts/install-desktop.sh"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "cpu-features": false,
    "ssh2": false,
    "electron-winstaller": false
  },
  "build": {
    "appId": "dev.matheusinfo.echomanager",
    "productName": "Echo Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "!electron/screenshot.js",
      "dist/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "System",
      "icon": "build/icons",
      "executableName": "echo-manager",
      "synopsis": "Gerenciador desktop do Echo Show 5 com echo-penguin",
      "desktop": {
        "entry": {
          "Name": "Echo Manager",
          "Comment": "Saúde, Docker, logs, alarme e SSH do seu Echo",
          "Keywords": "echo;ssh;docker;alpine;penguin;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "appImage": {
      "artifactName": "EchoManager-${version}-${arch}.AppImage"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "homepage": "https://matheusinfo.dev",
  "desktopName": "echo-manager.desktop"
}
